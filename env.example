# Santo Niño, Cagayan — website configuration
# Copy this file to .env.local and fill in the official values.
# Every value is optional: src/config/site.ts has defaults for each one.

# Government information
VITE_GOVERNMENT_NAME="Municipality of Santo Niño"
VITE_GOVERNMENT_SHORT_NAME="Santo Niño"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region II – Cagayan Valley"
VITE_PROVINCE="Cagayan"
VITE_SITE_TAGLINE="Serbisyong tapat, bukas, at para sa lahat ng Santo Niñeño."

# Contact information (TODO: official values)
VITE_ADDRESS="Municipal Hall, Poblacion, Santo Niño, Cagayan"
VITE_CONTACT_PHONE="(078) 000-0000"
VITE_CONTACT_EMAIL="info@santonino-cagayan.gov.ph"
VITE_OFFICE_HOURS="Monday to Friday, 8:00 AM – 5:00 PM"
VITE_WEBSITE_URL="https://santonino-cagayan.gov.ph"

# Social media (links are hidden when empty)
VITE_FACEBOOK_URL=""
VITE_YOUTUBE_URL=""
VITE_INSTAGRAM_URL=""
VITE_TWITTER_URL=""

# SEO
VITE_SITE_DESCRIPTION="Official website of the Municipality of Santo Niño, Cagayan. Services, news, transparency, and hotlines."
VITE_SITE_KEYWORDS="Santo Niño, Cagayan, LGU, municipality, government services, transparency, full disclosure"
VITE_OG_IMAGE_URL=""
VITE_TWITTER_HANDLE=""

# Search (optional, see docs/meilisearch.md)
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""
