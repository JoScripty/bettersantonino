# BetterSantoNiño.org — website configuration
# An independent community portal, NOT the official LGU website.
# Copy this file to .env.local and fill in the values.
# Every value is optional: src/config/site.ts has defaults for each one.

# Site / organization
VITE_SITE_NAME="BetterSantoNiño.org"
VITE_SITE_TAGLINE="A community-run guide to the services, news, and public records of Santo Niño, Cagayan."
# Contact e-mail of the organization (hidden when empty)
VITE_CONTACT_EMAIL=""
VITE_WEBSITE_URL="https://bettersantonino.org"

# Local government the site is about
VITE_GOVERNMENT_NAME="Municipality of Santo Niño"
VITE_GOVERNMENT_SHORT_NAME="Santo Niño"
VITE_REGION="Region II – Cagayan Valley"
VITE_PROVINCE="Cagayan"

# Municipal Hall contact details, shown as government contact info (TODO: verify)
VITE_ADDRESS="Municipal Hall, Poblacion, Santo Niño, Cagayan"
VITE_CONTACT_PHONE="(078) 000-0000"
VITE_OFFICE_HOURS="Monday to Friday, 8:00 AM – 5:00 PM"

# Social media of the organization (links are hidden when empty)
VITE_FACEBOOK_URL=""
VITE_YOUTUBE_URL=""
VITE_INSTAGRAM_URL=""
VITE_TWITTER_URL=""

# SEO
VITE_SITE_DESCRIPTION="BetterSantoNiño.org is an independent community guide to the services, news, and public records of Santo Niño, Cagayan. Not an official government website."
VITE_SITE_KEYWORDS="BetterSantoNiño, Santo Niño, Cagayan, civic tech, government services, transparency, full disclosure"
VITE_OG_IMAGE_URL=""
VITE_TWITTER_HANDLE=""

# Search (optional, see docs/meilisearch.md)
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""
